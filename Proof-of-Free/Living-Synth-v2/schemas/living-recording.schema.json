{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proof-of-free.example/schemas/living-recording-v1.json",
  "title": "Proof of Free Living Recording v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "version", "parent", "engine", "gestures", "createdAt"],
  "properties": {
    "protocol": { "const": "proof-of-free/living-recording" },
    "version": { "const": 1 },
    "parent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["xtrataContract", "nftId", "edition"],
      "properties": {
        "xtrataContract": { "type": "string", "minLength": 3 },
        "nftId": { "type": "integer", "minimum": 0 },
        "edition": { "type": "integer", "minimum": 1, "maximum": 1024 }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sampleRate", "loopMs", "waveform"],
      "properties": {
        "sampleRate": { "type": "integer", "minimum": 8000, "maximum": 192000 },
        "loopMs": { "type": "integer", "minimum": 250, "maximum": 120000 },
        "waveform": { "enum": ["sine", "square", "sawtooth", "triangle"] }
      }
    },
    "gestures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "x", "y", "pressure", "gate"],
        "properties": {
          "at": { "type": "integer", "minimum": 0, "maximum": 120000 },
          "x": { "type": "number", "minimum": 0, "maximum": 1 },
          "y": { "type": "number", "minimum": 0, "maximum": 1 },
          "pressure": { "type": "number", "minimum": 0, "maximum": 1 },
          "gate": { "enum": ["on", "move", "off"] }
        }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}

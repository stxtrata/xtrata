{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vitest/globals"]
  },
  "include": [
    "src",
    "tests",
    "vite.config.ts",
    "node_modules/@stacks/clarinet-sdk/vitest-helpers/src/global.d.ts",
    "node_modules/@stacks/clarinet-sdk/vitest-helpers/src/vitest.d.ts"
  ]
}

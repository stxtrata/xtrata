+  (begin
+    (try! (assert-owner))
+    (asserts! (not (var-get canonical-finalized)) ERR-FINALIZED)
+    (let ((r (fold seed-one entries { ok: true, added: u0 })))
+      (asserts! (get ok r) ERR-BAD-CANONICAL)

+  (let ((fee (fee-for-internal payer)))
+    (if (or (is-eq fee u0) (is-eq payer (var-get fee-recipient)))
+      (ok true)
+      (stx-transfer? fee payer (var-get fee-recipient)))))
+
+;; =============================================================================
+;; canonical record lifecycle (admin, before finalisation only)
+;; =============================================================================

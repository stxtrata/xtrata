# Xtrata Agent One — never commit secrets, keys, or user data.

# Per-job state — HOLDS EPHEMERAL DEPOSIT-WALLET KEYS (seed phrases) until delivery.
# Committing this leaks private keys. NEVER commit.
svc/job-state/

# Uploaded source files (user audio/images) + generated artifacts
svc/uploads/
svc/receipts/

# Generated assets written next to uploads (Opus + players)
*.opus-hq.weba
*.player.html

# Runtime job output (regenerated by the staged-upload engine)
large-map.json

# Dependencies & secrets
node_modules/
.env
.env.*
!.env.example

# OS cruft
.DS_Store

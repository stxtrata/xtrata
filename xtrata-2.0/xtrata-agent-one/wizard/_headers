/opus-file-generator/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# SUNO page builds the player with ffmpeg.wasm → needs SharedArrayBuffer → cross-origin isolation.
# Scoped to /suno only so the main wizard's wallet flow is unaffected.
/wizard/suno
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
/wizard/suno.html
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# Agent One ships its JS under stable filenames (agent-one.js, suno-build.js, HTML_Template.js).
# Force revalidation so a redeploy is never served from a stale CDN/browser cache.
/wizard/*.js
  Cache-Control: no-cache

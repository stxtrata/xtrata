/opus-file-generator/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# SUNO page builds the player with ffmpeg.wasm (multithreaded core) → needs
# SharedArrayBuffer → cross-origin isolation. Scoped to /suno only so the main
# wizard's wallet flow is unaffected. The main wizard's audio optimiser uses the
# single-threaded core (@ffmpeg/core-st), which needs no isolation headers.
/wizard/suno
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
/wizard/suno.html
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# The wizard ships its JS under stable filenames (agent-one.js, suno-build.js,
# HTML_Template.js, optimize-audio.js). Force revalidation so a redeploy is
# never served from a stale CDN/browser cache.
#
# EXACT PATHS, deliberately. `/wizard/*.js` silently did nothing: Cloudflare Pages
# does not support a `*` in the middle of a path segment, so the rule never matched
# and these files fell back to the Pages default of max-age=14400. A redeploy could
# therefore be shadowed by a four-hour-old bundle — which is exactly what happened,
# with the page refusing to run against an agent build eleven versions behind.
/wizard/agent-one.js
  Cache-Control: no-cache
/wizard/agent-one-wallet.js
  Cache-Control: no-cache
/wizard/suno-build.js
  Cache-Control: no-cache
/wizard/HTML_Template.js
  Cache-Control: no-cache
/wizard/optimize-audio.js
  Cache-Control: no-cache
/wizard/optimize-image.js
  Cache-Control: no-cache

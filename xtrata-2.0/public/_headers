/opus-file-generator/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# SUNO page builds the player with ffmpeg.wasm (multithreaded core) → needs
# SharedArrayBuffer → cross-origin isolation. Scoped to /suno only so the main
# wizard's wallet flow is unaffected. The main wizard's audio optimiser uses the
# single-threaded core (@ffmpeg/core-st), which needs no isolation headers.
/wizard/suno
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
/wizard/suno.html
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# The wizard ships its JS under stable filenames (agent-one.js, suno-build.js,
# HTML_Template.js, optimize-audio.js). Force revalidation so a redeploy is
# never served from a stale CDN/browser cache.
/wizard/*.js
  Cache-Control: no-cache

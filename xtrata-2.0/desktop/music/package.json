{
  "name": "xtrata-music-desktop",
  "productName": "Xtrata Music",
  "version": "1.0.7",
  "description": "On-chain music and optional local support payments",
  "author": "Xtrata",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "prepare:app": "node prepare.mjs",
    "start": "npm run prepare:app && electron .",
    "pack": "npm run prepare:app && electron-builder --dir",
    "dist:mac": "npm run prepare:app && electron-builder --mac dmg zip --universal --publish never -c.extraMetadata.version=1.0.4",
    "pack:win": "npm run prepare:app && electron-builder --win --x64 --dir --publish never",
    "dist:win": "npm run prepare:app && electron-builder --win nsis --x64 --publish never",
    "test:win:storage": "node ../../scripts/music-support/windows-storage-smoke.mjs",
    "dist:linux": "npm run prepare:app && electron-builder --linux AppImage --publish never",
    "release:patch": "node bump-version.mjs",
    "dist:mac:legacy": "npm run prepare:app && electron-builder --mac dmg zip --universal --publish never -c.electronVersion=43.7.3 -c.directories.output=../../.artifacts/music-desktop-legacy '-c.artifactName=Xtrata-Music-Legacy-${version}-${os}-${arch}.${ext}' -c.extraMetadata.version=1.0.4"
  },
  "dependencies": {
    "@stacks/transactions": "6.17.0",
    "@stacks/network": "6.17.0",
    "@noble/hashes": "1.8.0"
  },
  "devDependencies": {
    "electron": "44.4.1",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "xyz.xtrata.music",
    "productName": "Xtrata Music",
    "asar": true,
    "directories": {
      "output": "../../.artifacts/music-desktop"
    },
    "files": [
      "main.mjs",
      "window.mjs",
      "navigation.mjs",
      "release-platforms.mjs",
      "unavailable-wallet.mjs",
      "windows-vault-protection.mjs",
      "assets/xtrata-music.png",
      "assets/xtrata-music.ico",
      "app/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.ts",
      "!**/*.tsx",
      "!app/smoke-entry.mjs",
      "!app/startup-test.mjs"
    ],
    "protocols": [
      {
        "name": "Xtrata Music",
        "schemes": [
          "xtrata-music"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "icon": "assets/xtrata-music.icns"
    },
    "win": {
      "icon": "assets/xtrata-music.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Xtrata-Music-${version}-windows11-preview-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": false,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": "AppImage",
      "category": "AudioVideo",
      "icon": "assets/xtrata-music.png"
    },
    "artifactName": "Xtrata-Music-${version}-${os}-${arch}.${ext}"
  }
}

# Wizard test wallet keys. Real mainnet private keys, never committed.
# scripts/wizard/.env.wizards.example holds the placeholders and IS committed.
.env.wizards
scripts/wizard/.env.wizards
scripts/wizard/KILL

# Thread runner journals. Local state about one operator's in-flight run:
# txids, inscription ids and what has been spent. No key material, by assertion.
scripts/wizard/.run-*.json

# Market runner journals. Same shape, same assertion: txids, listing ids, which
# scenario opened what, and what is still in escrow.
scripts/wizard/.market-*.json

# Collection runner journals. Same shape again, keyed by piece index.
scripts/wizard/.collection-*.json
# The pipeline journal. Holds addresses, txids and the resolved id map -- no
# keys (assertJournalSecretFree refuses to write one), but it is run state and
# not source. Added after a real run left it showing as untracked.
scripts/wizard/.pipeline-*.json



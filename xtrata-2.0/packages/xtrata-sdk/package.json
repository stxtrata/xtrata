{
  "name": "@xtrata/sdk",
  "version": "0.2.0",
  "description": "TypeScript SDK for the Xtrata contract-native inscription protocol on Stacks: read clients, mint/collection/market workflow planners, safe spend caps, sponsored-transaction client, and multi-asset payment helpers.",
  "license": "MIT",
  "author": "Xtrata",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stxtrata/xtrata.git",
    "directory": "xtrata-2.0/packages/xtrata-sdk"
  },
  "homepage": "https://github.com/stxtrata/xtrata#readme",
  "keywords": [
    "stacks",
    "bitcoin",
    "inscriptions",
    "nft",
    "sip-009",
    "sip-010",
    "clarity",
    "sbtc",
    "xtrata"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./network": {
      "types": "./dist/network.d.ts",
      "import": "./dist/network.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./mint": {
      "types": "./dist/mint.d.ts",
      "import": "./dist/mint.js"
    },
    "./collections": {
      "types": "./dist/collections.d.ts",
      "import": "./dist/collections.js"
    },
    "./market": {
      "types": "./dist/market.d.ts",
      "import": "./dist/market.js"
    },
    "./deploy": {
      "types": "./dist/deploy.d.ts",
      "import": "./dist/deploy.js"
    },
    "./simple": {
      "types": "./dist/simple.d.ts",
      "import": "./dist/simple.js"
    },
    "./safe": {
      "types": "./dist/safe.d.ts",
      "import": "./dist/safe.js"
    },
    "./workflows": {
      "types": "./dist/workflows.d.ts",
      "import": "./dist/workflows.js"
    },
    "./backup-migration": {
      "types": "./dist/backup-migration.d.ts",
      "import": "./dist/backup-migration.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./sponsor": {
      "types": "./dist/sponsor.d.ts",
      "import": "./dist/sponsor.js"
    },
    "./payments": {
      "types": "./dist/payments.d.ts",
      "import": "./dist/payments.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run src/__tests__",
    "prepack": "npm run clean && npm run build"
  },
  "dependencies": {
    "@noble/hashes": "^1.4.0",
    "@stacks/connect": "^7.8.0",
    "@stacks/network": "^6.11.0",
    "@stacks/transactions": "^6.11.0"
  }
}

{
  "name": "@xtrata/reconstruction",
  "version": "0.2.0",
  "description": "Strict byte reconstruction for Xtrata inscriptions: batch chunk reads, fallback sources, diagnostics, and incremental hash verification.",
  "license": "MIT",
  "author": "Xtrata",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stxtrata/xtrata.git",
    "directory": "xtrata-2.0/packages/xtrata-reconstruction"
  },
  "homepage": "https://github.com/stxtrata/xtrata#readme",
  "keywords": [
    "stacks",
    "bitcoin",
    "inscriptions",
    "nft",
    "sip-009",
    "sip-010",
    "clarity",
    "sbtc",
    "xtrata"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run src/__tests__",
    "prepack": "npm run clean && npm run build"
  },
  "dependencies": {
    "@noble/hashes": "^1.4.0"
  }
}

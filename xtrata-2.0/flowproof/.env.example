# ─────────────────────────────────────────────────────────────────────────────
# FlowProof environment
#
# IMPORTANT — network coherence:
#   FlowVault is deployed on TESTNET only. Xtrata v3.2.3 is live on MAINNET.
#   For one coherent demo, deploy xtrata-v3.2.3 to testnet (source lives at
#   contracts/clarinet/contracts/xtrata-v3.2.3.clar) and point XTRATA_* at it.
#   Keep NETWORK, FlowVault, and Xtrata on the SAME network.
# ─────────────────────────────────────────────────────────────────────────────

# "testnet" | "mainnet"  (use testnet for the bounty demo)
NETWORK=testnet

# Server signer for the autonomous / zero-touch orchestrator.
# Never commit a real key. Use a throwaway testnet account funded from the faucet.
STACKS_PRIVATE_KEY=

# ── FlowVault (money layer) ── verified testnet coordinates from docs.flow-vault.dev
FLOWVAULT_CONTRACT_ADDRESS=STD7QG84VQQ0C35SZM2EYTHZV4M8FQ0R7YNSQWPD
FLOWVAULT_CONTRACT_NAME=flowvault-v2
USDCX_CONTRACT_ADDRESS=ST1PQHQKV0RJXZFY1DGX8MNSNYVE3VGZJSRTPGZGM
USDCX_CONTRACT_NAME=usdcx

# ── Xtrata (record layer) ── v3.2.3
# Mainnet live:  SP3JNSEXAZP4BDSHV0DN3M8R3P0MY0EEBQQZX743X.xtrata-v3-2-3
# Testnet:       deploy xtrata-v3.2.3.clar yourself, then put that address here.
XTRATA_CONTRACT_ADDRESS=
XTRATA_CONTRACT_NAME=xtrata-v3-2-3

# ── Pattern B composing contract (atomic deposit + inscribe) ──
# Set by `npm run deploy-treasury`. Defaults to your deployer address + flowproof-treasury.
TREASURY_CONTRACT_ADDRESS=
TREASURY_CONTRACT_NAME=flowproof-treasury

# Optional: Xtrata relationship index base URL (for lineage queries in the UI).
# Leave blank to fall back to on-chain get-parents / get-dependencies reads.
XTRATA_INDEX_BASE_URL=

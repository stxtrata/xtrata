# Clarinet regenerates this on every contract test run, with FRESH RANDOM
# wallet addresses each time - settings/Devnet.toml carries no mnemonic, so
# there is nothing for the derivation to be stable against.
#
# Committing it meant `git status` was dirty after every `npm run test:clarity`
# or `npm run verify`, and every commit of it was a diff of eight addresses
# that mean nothing. The tests look wallets up by NAME (accounts.get('wallet_5')
# and never by literal address, and the part that carries meaning - wallet_5
# holding 5,000 uSTX and wallet_6 holding exactly nothing - lives in
# settings/Devnet.toml, which IS committed.
#
# Verified before untracking: delete the file entirely and the contract suite
# still passes 48/48, regenerating it from scratch.
deployments/default.simnet-plan.yaml

# ops/upgrades.html is the browsable build of ops/UPGRADES.md, generated and
# published as an artefact. The markdown is the source; a committed copy of the
# rendered page would only go stale beside it.
ops/upgrades.html

# Real wizard keys. Disposable mainnet wallets holding a few STX, generated by
# harness/wizards/make-wizards.mjs, which prints them once and writes them
# nowhere. This file is yours to create and no script ever writes it.
#
# harness/wizards/.env.wizards.example holds the placeholders and IS committed;
# a test asserts it contains nothing key-shaped and no mainnet address.
harness/wizards/.env.wizards

# A BIP39 phrase. Never committed, never anywhere but mode 600 on one machine.
harness/bns/.seed

# A personal holdings inventory. Public per-name on chain; not as one list.
harness/bns/names.txt

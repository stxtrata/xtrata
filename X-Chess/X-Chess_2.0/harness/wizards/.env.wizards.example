# harness/wizards/.env.wizards.example
#
# PLACEHOLDERS ONLY. This file is committed; .env.wizards is not.
# Generate real values with: node harness/wizards/make-wizards.mjs
#
# A test in tests/wizards asserts this file contains nothing key-shaped and
# no mainnet address, so a real key pasted here fails the build rather than
# reaching a commit.

# Director — The one address you fund. Distributes floats to the players and never signs a game. May only pay its own fleet.
XCHESS_DIRECTOR_KEY=REPLACE_WITH_A_GENERATED_KEY
XCHESS_DIRECTOR_ADDRESS=REPLACE_WITH_ITS_ADDRESS

# Opener — Opens games and moves first. The only wizard that spends the open fee.
XCHESS_WIZARD_1_KEY=REPLACE_WITH_A_GENERATED_KEY
XCHESS_WIZARD_1_ADDRESS=REPLACE_WITH_ITS_ADDRESS

# Responder — Answers. Proves a second independent signer reaches the same position.
XCHESS_WIZARD_2_KEY=REPLACE_WITH_A_GENERATED_KEY
XCHESS_WIZARD_2_ADDRESS=REPLACE_WITH_ITS_ADDRESS

# Patron — Funds a sponsored game for a wallet holding nothing, and never plays. The only one that exercises the contract paying STX OUT, which is the path row 4 of the matrix is about.
XCHESS_WIZARD_3_KEY=REPLACE_WITH_A_GENERATED_KEY
XCHESS_WIZARD_3_ADDRESS=REPLACE_WITH_ITS_ADDRESS
